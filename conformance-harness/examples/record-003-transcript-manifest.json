  "tests": [
    {
      "test_id": "CT-R003-POS-001",
      "operation": "evaluate_transcript_binding",
      "required_capability": "transcript-binding",
      "expected_status": "accepted",
      "expected_reason": "transcript-bound-and-policy-accepted",
      "request": {
        "proof_transcript_digest": "sha256:abc",
        "supplied_transcript_digest": "sha256:abc",
        "canonical_encoding_valid": true,
        "predicate_accepted": true,
        "audience_match": true,
        "context_match": true,
        "challenge_match": true,
        "expired": false,
        "replay_seen": false
      }
    },
    {
      "test_id": "CT-R003-NEG-001",
      "operation": "evaluate_transcript_binding",
      "required_capability": "transcript-binding",
      "expected_status": "rejected",
