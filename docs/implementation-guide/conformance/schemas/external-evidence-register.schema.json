{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External evidence register",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "repository", "reviewedRevision", "reviewedAt", "authority", "evidenceTypes", "licenseStatus", "permittedUse", "vendoringPermitted", "ciDependency", "conformanceCredit", "retestTriggers"],
        "properties": {
          "id": {"type": "string", "pattern": "^EXT-[A-Z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "format": "uri"},
          "reviewedRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "reviewedAt": {"type": "string", "format": "date"},
          "authority": {"enum": ["experimental-evidence", "implementation-evidence", "normative"]},
          "evidenceTypes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "licenseStatus": {"enum": ["verified", "unverified", "incompatible", "not-applicable"]},
          "permittedUse": {"enum": ["reference-and-independent-observation-only", "reproduction-only", "import-with-attribution"]},
          "vendoringPermitted": {"type": "boolean"},
          "ciDependency": {"type": "boolean"},
          "conformanceCredit": {"enum": ["none", "observational", "reproduced"]},
          "retestTriggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
