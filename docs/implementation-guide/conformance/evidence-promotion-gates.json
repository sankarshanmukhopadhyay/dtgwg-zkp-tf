      "claim_scope": "specific construction execution"
    },
    "independent_reproduction": {
      "independence": "required",
      "claim_scope": "repeatability of named result"
    },
    "cross_implementation": {
      "independence": "required",
      "claim_scope": "interoperability for exact vectors/profile"
    },
    "privacy_adversarial": {
