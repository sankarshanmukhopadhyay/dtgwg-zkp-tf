  "independent_reproduction_contract": {
    "minimum": [
      "different maintainer/operator or independently maintained implementation",
      "immutable source revision",
      "exact vector/profile identifier",
      "environment/runtime declaration",
      "verifier-observable result and reason codes",
      "evidence artifact digest",
      "statement of what was not reproduced"
    ],
    "prohibited_shortcuts": [
      "two code paths maintained by the same operator counted as independent",
      "CI rerun counted as independent reproduction",
      "semantic fixture pass counted as cryptographic interoperability",
      "external library interoperability counted as DTG composed-record interoperability without DTG vectors"
    ]
  }
